# Copy to /opt/1panel/docker/compose/zterm-relay/.env on the deployment host.
# `.env` is ignored by Git. Replace the placeholder with the multi-platform
# digest emitted by the GitHub Actions relay-image workflow; tags are forbidden
# for production deployment.
RELAY_IMAGE=ghcr.io/leonfox28/zterm-relay@sha256:REPLACE_WITH_PUBLISHED_DIGEST
RELAY_PROXY_PORT=38451
RELAY_METRICS_PORT=9090
RELAY_LOG_LEVEL=info
