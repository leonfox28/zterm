# Copy to the direct-TLS deployment directory only after the public-server
# checkpoint. `.env` is ignored by Git. Replace the image placeholder with the
# multi-platform digest emitted by GitHub Actions; tags are forbidden for
# production deployment.
RELAY_HOSTNAME=relay.example.com
RELAY_ACME_CONTACT=ops@example.com
RELAY_ACME_PRODUCTION=true
RELAY_IMAGE=ghcr.io/leonfox28/zterm-relay@sha256:REPLACE_WITH_PUBLISHED_DIGEST
RELAY_PUBLIC_BIND_IP=0.0.0.0
RELAY_METRICS_PORT=9090
RELAY_LOG_LEVEL=info
